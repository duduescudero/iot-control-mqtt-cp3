{
  "name": "iot-control-mqtt-cp3",
  "description": "Painel IoT em Expo e TypeScript com MQTT via WebSocket.",
  "license": "MIT",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.19",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "paho-mqtt": "1.1.0",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-svg": "15.16.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@types/paho-mqtt": "1.0.10",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "mqtt": "5.16.1",
    "aedes": "1.2.0",
    "ws": "^8.18.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "broker": "node scripts/broker.mjs",
    "simulate": "node scripts/simulator.mjs",
    "build:web": "expo export --platform web",
    "build:all": "expo export --platform all",
    "verify": "npm run typecheck && npm test && npm run build:web"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
